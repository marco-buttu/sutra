{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientia.yoga/schemas/voices.schema.json",
  "title": "Sutra by Heart voices",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "recitationLanguage"],
    "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
      "name": {"type": "string", "minLength": 1},
      "recitationLanguage": {"type": "string", "minLength": 2}
    }
  }
}
