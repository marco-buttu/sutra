{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientia.yoga/schemas/catalog.schema.json",
  "title": "Sutra by Heart catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultLocale",
    "sourceLocale",
    "supportedLocales",
    "defaultVoiceId",
    "credits",
    "features"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "minimum": 1},
    "defaultLocale": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "sourceLocale": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"},
    "supportedLocales": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$"}
    },
    "defaultVoiceId": {"type": "string", "minLength": 1},
    "credits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorName", "authorUrl", "voiceHonorific", "voiceName", "voiceUrl"],
      "properties": {
        "authorName": {"type": "string", "minLength": 1},
        "authorUrl": {"type": "string", "format": "uri"},
        "voiceHonorific": {"type": "string", "minLength": 1},
        "voiceName": {"type": "string", "minLength": 1},
        "voiceUrl": {"type": "string", "format": "uri"}
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "required": ["study", "continuousRecitation", "explanations", "tests"]
    }
  }
}
