{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scientia.yoga/schemas/chapters.schema.json",
  "title": "Sutra by Heart chapters",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "number", "slug", "theme", "sutraIds", "media"],
    "properties": {
      "id": {"type": "string", "pattern": "^chapter_[1-9][0-9]*$"},
      "number": {"type": "integer", "minimum": 1},
      "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "theme": {"type": "string", "minLength": 1},
      "sutraIds": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^sutra_[1-9][0-9]*_[0-9]{2,}$"}
      },
      "media": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coverImage", "video"],
        "properties": {
          "coverImage": {"type": ["string", "null"]},
          "video": {"type": ["string", "null"]}
        }
      }
    }
  }
}
